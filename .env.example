# The canonical origin. Used for metadata, og tags and every curl example in /docs.
NEXT_PUBLIC_ROYALTI_URL=https://royalti.fun

# The indexer that serves the real market. While this is empty the explore and
# coins pages render the seed set in src/lib/coins.ts and say so on the page.
NEXT_PUBLIC_ROYALTI_API=

# Embedded-wallet provider. This is what turns a handle into a claimable wallet:
# without it, social login is disabled in the UI and /api/v1/socials/resolve
# answers 501 instead of returning an address nobody could claim.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Chain RPC. /api/v1/register re-reads a token on-chain before trusting the body
# it was posted; without an RPC it answers 501.
ROYALTI_RPC_URL=
